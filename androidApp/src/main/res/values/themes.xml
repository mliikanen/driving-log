<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws the app bar, so the framework action bar is disabled. DayNight follows the system setting. -->
    <style name="Theme.DrivingLog" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <!-- The window shows this before the first frame: the scheme's background, not a white or black flash. -->
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
