<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ML Kit's text recognizer (add-odometer-ocr-capture) runs on the device with its model bundled; these two come only with the
         usage telemetry library it pulls in (com.google.android.datatransport), which the app does not need. Removed so the app asks
         for no system permission (maestro/check-permissions.sh), and recognition cannot reach the network. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <!-- The live scanner's in-app camera preview (add-live-scanner): no system chooser or intent can show one. Asked for when "Scan a
         reading" is tapped, never before; a device without a camera still installs the app and uses the photo flow. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Lets the photo chooser list the camera apps (up to two) under their own names (ask-camera-for-camera-app): on API 30+ the
         camera apps are visible only through this. Not a permission. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <!-- No icon yet: update-app-icon sets android:icon and removes this suppression (clean-up-lint-baselines). -->
    <application
        android:name=".DrivingLogApplication"
        tools:ignore="MissingApplicationIcon"
        android:label="Driving Log"
        android:supportsRtl="true"
        android:theme="@style/Theme.DrivingLog">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The camera apps in the photo chooser (ask-camera-for-camera-app). Because CAMERA is declared above, Android opens a camera app for
             the app only while it holds CAMERA. The chooser's refinement step, run after the user picks an app and before its launch, goes
             to the receiver, which asks for CAMERA first (the activity, no UI of its own: the prompt shows over the chooser) when a camera
             app was picked without it; a refusal launches nothing, and the picker reports it. Neither is exported: only the chooser, through the
             app's own PendingIntent and as the app, starts them. -->
        <receiver
            android:name="com.mikonoma.drivinglog.vehicle.picture.CameraRefinementReceiver"
            android:exported="false" />
        <activity
            android:name="com.mikonoma.drivinglog.vehicle.picture.CameraPermissionActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Lets the camera app write a new photo to the app's cache. The camera app holds its own camera permission; the app asks for
             its own only to open it (CameraRefinementReceiver). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.pictures"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/picture_paths" />
        </provider>
    </application>
</manifest>
