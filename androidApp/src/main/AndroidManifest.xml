<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ML Kit's text recognizer (add-odometer-ocr-capture) runs on the device with its model bundled; these two come only with the
         usage telemetry library it pulls in (com.google.android.datatransport), which the app does not need. Removed so the app asks
         for no system permission (maestro/check-permissions.sh), and recognition cannot reach the network. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <!-- The live scanner's in-app camera preview (add-live-scanner): no system chooser or intent can show one. Asked for when "Scan a
         reading" is tapped, never before; a device without a camera still installs the app and uses the photo flow. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".DrivingLogApplication"
        android:label="Driving Log"
        android:supportsRtl="true"
        android:theme="@style/Theme.DrivingLog">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lets the camera app write a new photo to the app's cache. No permission is declared: the camera app holds its own. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.pictures"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/picture_paths" />
        </provider>
    </application>
</manifest>
