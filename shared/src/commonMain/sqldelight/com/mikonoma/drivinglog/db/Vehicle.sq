-- Everything stored here is locale-agnostic: whole meters, epoch milliseconds, UUIDs and enum codes.

CREATE TABLE vehicle (
    id            TEXT    NOT NULL PRIMARY KEY,
    name          TEXT    NOT NULL,
    license_plate TEXT,
    -- OdometerUnit.code: KILOMETERS, KILOMETERS_TENTHS, MILES or MILES_TENTHS. Written once, at creation.
    odometer_unit TEXT    NOT NULL,
    created_at    INTEGER NOT NULL,
    updated_at    INTEGER NOT NULL,
    -- The "include tenths" choice last used when logging a distance for this vehicle: 1 with tenths, 0 without,
    -- null when none was saved yet (the form then starts with the tenths of odometer_unit).
    log_distance_tenths INTEGER,
    -- The id of the vehicle's picture: the files are named by it in the application's private storage, never a path. Null: no picture.
    picture_id    TEXT,
    -- The kind of vehicle: a VehicleType code (CAR, SUV, VAN, ...). Never null: every vehicle has a type (a vehicle from before types existed is a CAR).
    -- An unknown code (from a newer app) reads as OTHER.
    vehicle_type  TEXT    NOT NULL DEFAULT 'CAR',
    -- The vehicle's color as RRGGBB (upper case). Never null: every vehicle has one, and the default is the application's main theme color (the same
    -- value as VehicleColors.default, which a test ties to this). A value that is not six hex digits reads as the default.
    vehicle_color TEXT    NOT NULL DEFAULT '203A43'
);

insertVehicle:
INSERT INTO vehicle (id, name, license_plate, odometer_unit, created_at, updated_at, picture_id, vehicle_type, vehicle_color)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Only name and plate can change. The unit and the log are never touched.
updateVehicle:
UPDATE vehicle SET name = ?, license_plate = ?, updated_at = ? WHERE id = ?;

-- Sets the vehicle's type. Editing the type is a vehicle edit, so updated_at moves.
updateVehicleType:
UPDATE vehicle SET vehicle_type = ?, updated_at = ? WHERE id = ?;

-- Sets the vehicle's color. Editing the color is a vehicle edit, so updated_at moves.
updateVehicleColor:
UPDATE vehicle SET vehicle_color = ?, updated_at = ? WHERE id = ?;

-- Points the vehicle at another picture (or none). Editing the picture is a vehicle edit, so updated_at moves.
updateVehiclePicture:
UPDATE vehicle SET picture_id = ?, updated_at = ? WHERE id = ?;

-- The remembered tenths choice of the log distance form. It is not a name or plate edit, so updated_at is left alone.
updateLogDistanceTenths:
UPDATE vehicle SET log_distance_tenths = ? WHERE id = ?;

selectPictureId:
SELECT picture_id FROM vehicle WHERE id = ?;

selectVehicles:
SELECT id, name, license_plate, odometer_unit, created_at, log_distance_tenths, picture_id, vehicle_type, vehicle_color
FROM vehicle
ORDER BY created_at, rowid;

-- The current odometer is derived from the log: the latest event that sets the odometer (ordered by instant, then insertion),
-- plus the distance of every DISTANCE event after it. Distance entries dated before that event do not count.
selectVehicleDetails:
SELECT
    v.id,
    v.name,
    v.license_plate,
    v.odometer_unit,
    v.created_at,
    v.log_distance_tenths,
    v.picture_id,
    v.vehicle_type,
    v.vehicle_color,
    (
        SELECT CAST(b.odometer_meters + COALESCE((
            SELECT SUM(d.distance_meters)
            FROM vehicle_event d
            WHERE d.vehicle_id = v.id
              AND d.type = 'DISTANCE'
              AND (d.occurred_at > b.occurred_at OR (d.occurred_at = b.occurred_at AND d.rowid > b.rowid))
        ), 0) AS INTEGER)
        FROM vehicle_event b
        WHERE b.vehicle_id = v.id AND b.odometer_meters IS NOT NULL
        ORDER BY b.occurred_at DESC, b.rowid DESC
        LIMIT 1
    ) AS current_odometer_meters
FROM vehicle v
WHERE v.id = ?;
