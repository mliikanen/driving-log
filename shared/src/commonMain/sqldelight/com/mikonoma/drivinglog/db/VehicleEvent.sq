-- One fact in a vehicle's log (atomic-log-events): an odometer reading, a distance or a refueling. Every event belongs to one
-- log_entry, which holds the note and photos shared by all of its events.
CREATE TABLE vehicle_event (
    id              TEXT    NOT NULL PRIMARY KEY,
    vehicle_id      TEXT    NOT NULL REFERENCES vehicle(id),
    entry_id        TEXT    NOT NULL REFERENCES log_entry(id),
    -- ODOMETER_READING sets the odometer; DISTANCE adds a distance to it; REFUELING adds fuel and never touches the odometer.
    type            TEXT    NOT NULL,
    -- The instant, in epoch milliseconds. All ordering and derivation use it. Every event of one entry has the same instant.
    occurred_at     INTEGER NOT NULL,
    -- ODOMETER_READING only: the reading it sets.
    odometer_meters INTEGER,
    created_at      INTEGER NOT NULL,
    -- DISTANCE only: the distance, in whole meters, added to the odometer.
    distance_meters INTEGER,
    -- DISTANCE logged by odometer: the count the user typed. Provenance for the log row only, never used to derive an odometer.
    logged_odometer_meters INTEGER,
    -- The IANA time zone the moment was entered in and its UTC offset then. Null for events from before zones were stored.
    occurred_zone   TEXT,
    occurred_offset_seconds INTEGER,
    -- REFUELING only (add-refueling-logging): the fuel amount, in whole milliliters.
    fuel_amount_milliliters INTEGER,
    -- REFUELING only: the unit (FuelUnit code) the amount was entered in; shown in that unit always, never converted.
    fuel_unit       TEXT,
    -- REFUELING only: the fuel type's locale-agnostic code (FuelType).
    fuel_type       TEXT,
    -- REFUELING only: whether the tank was filled up (1) or it was a partial fill (0).
    filled_up       INTEGER
);

CREATE INDEX vehicle_event_by_vehicle ON vehicle_event (vehicle_id, occurred_at DESC);

CREATE INDEX vehicle_event_by_entry ON vehicle_event (entry_id);

-- The log is append-only, except for the one narrow exception of an entry's note and photos (LogEntry.sq, EventPicture.sq):
-- there is deliberately no delete or update query for events.
insertOdometerReading:
INSERT INTO vehicle_event (id, vehicle_id, entry_id, type, occurred_at, odometer_meters, created_at, occurred_zone, occurred_offset_seconds)
VALUES (?, ?, ?, 'ODOMETER_READING', ?, ?, ?, ?, ?);

insertDistanceEntry:
INSERT INTO vehicle_event (id, vehicle_id, entry_id, type, occurred_at, created_at, distance_meters, logged_odometer_meters, occurred_zone, occurred_offset_seconds)
VALUES (?, ?, ?, 'DISTANCE', ?, ?, ?, ?, ?, ?);

insertRefueling:
INSERT INTO vehicle_event (
    id, vehicle_id, entry_id, type, occurred_at, created_at, occurred_zone, occurred_offset_seconds,
    fuel_amount_milliliters, fuel_unit, fuel_type, filled_up
)
VALUES (?, ?, ?, 'REFUELING', ?, ?, ?, ?, ?, ?, ?, ?);

-- Newest first: the reverse of log order (vehicle-log, "Events at the same time are ordered by entry, then by kind"): by
-- instant, then by entry in the order the entries were added (log_entry's rowid), then by kind within an entry
-- (ODOMETER_READING, DISTANCE, REFUELING oldest first). Each row carries its entry's source and note.
selectRecentEvents:
SELECT e.id, e.entry_id, l.source, e.type, e.occurred_at, e.odometer_meters, e.distance_meters, e.logged_odometer_meters,
       e.occurred_zone, e.occurred_offset_seconds, l.note, e.fuel_amount_milliliters, e.fuel_unit, e.fuel_type, e.filled_up
FROM vehicle_event e
JOIN log_entry l ON l.id = e.entry_id
WHERE e.vehicle_id = ?
ORDER BY e.occurred_at DESC, l.rowid DESC,
         CASE e.type WHEN 'ODOMETER_READING' THEN 0 WHEN 'DISTANCE' THEN 1 ELSE 2 END DESC
LIMIT ?;

selectLog:
SELECT e.id, e.entry_id, l.source, e.type, e.occurred_at, e.odometer_meters, e.distance_meters, e.logged_odometer_meters,
       e.occurred_zone, e.occurred_offset_seconds, l.note, e.fuel_amount_milliliters, e.fuel_unit, e.fuel_type, e.filled_up
FROM vehicle_event e
JOIN log_entry l ON l.id = e.entry_id
WHERE e.vehicle_id = ?
ORDER BY e.occurred_at DESC, l.rowid DESC,
         CASE e.type WHEN 'ODOMETER_READING' THEN 0 WHEN 'DISTANCE' THEN 1 ELSE 2 END DESC;

-- Every event of the entry one event belongs to, in log order (oldest first), for the details screen
-- (add-event-details-view, atomic-log-events). Re-run whenever it might have changed, since nothing here caches it: the
-- details screen is meant to stay live.
selectEntryOfEvent:
SELECT e.id, e.entry_id, l.source, e.type, e.occurred_at, e.odometer_meters, e.distance_meters, e.logged_odometer_meters,
       e.occurred_zone, e.occurred_offset_seconds, l.note, e.fuel_amount_milliliters, e.fuel_unit, e.fuel_type, e.filled_up
FROM vehicle_event e
JOIN log_entry l ON l.id = e.entry_id
WHERE e.entry_id = (SELECT entry_id FROM vehicle_event WHERE vehicle_id = ? AND id = ?)
ORDER BY e.occurred_at, CASE e.type WHEN 'ODOMETER_READING' THEN 0 WHEN 'DISTANCE' THEN 1 ELSE 2 END;
